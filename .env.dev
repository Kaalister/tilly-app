# Tilly — configuration de developpement (builds debug).
#
# LICENSE_API_URL : URL de base de l'API de licence.
# Remplacer par https://tilly.orceus.fr pour tester la production en debug.
LICENSE_API_URL=http://localhost:3000
# DEV_UPDATE_CHECK : true pour tester les mises a jour depuis un build debug
# (ou --dart-define=DEV_UPDATE_CHECK=true sans modifier ce fichier).
DEV_UPDATE_CHECK=true
# DEV_LICENSE : force un etat de licence en debug uniquement
# (valid, none, grace, server, blocked, expired).
# Exemple : flutter run --dart-define=DEV_LICENSE=valid
DEV_LICENSE=
# DEV_DEMO_DATA : true pour remplir la base avec 3 journees de demonstration
# au premier lancement (debug uniquement, une seule fois).
DEV_DEMO_DATA=false
# DEV_TUTORIAL : on pour forcer le tuto, off pour le desactiver (debug).
DEV_TUTORIAL=
